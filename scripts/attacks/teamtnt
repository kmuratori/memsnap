# TeamTNT cloud cryptominer simulation
install_teamtnt() {
    echo "[*] Installing TeamTNT cloud cryptominer..."
    "$ASSETS_DIR/build/team_tnt_sim" && set_flag "teamtnt"
}

clean_teamtnt() {
    echo "[*] Cleaning TeamTNT..."
    pkill -f "team_tnt_sim" 2>/dev/null || true
    pkill -f "\[docker-cpu\]" 2>/dev/null || true
    rm -f /tmp/.teamtnt_*
    clear_flag "teamtnt"
}
