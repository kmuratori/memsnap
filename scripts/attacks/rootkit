# Diamorphine kernel module
install_rootkit() {
    echo "[*] Installing rootkit (Diamorphine)..."
    if [ ! -f "$ASSETS_DIR/diamorphine.ko" ]; then
        echo "[-] diamorphine.ko not found"
        return 1
    fi
    if insmod "$ASSETS_DIR/diamorphine.ko" 2>&1; then
        echo "[+] Diamorphine loaded"
        set_flag "rootkit"
    else
        echo "[-] insmod failed"
        return 1
    fi
}

clean_rootkit() {
    echo "[*] Cleaning rootkit..."
    if rmmod diamorphine 2>&1; then
        echo "[+] Diamorphine unloaded"
    else
        echo "[!] rmmod failed — module may still be loaded"
        return 1
    fi
    clear_flag "rootkit"
}
