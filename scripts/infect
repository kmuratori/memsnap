#!/usr/bin/env bash
# MemSnap infect – modular multi‑attack manager
set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ATTACKS_DIR="$SCRIPT_DIR/attacks"
export ASSETS_DIR="$SCRIPT_DIR/../assets"

# Flag management helpers
set_flag() {
    local name="$1"
    touch "/tmp/.${name}_active"
    echo "[+] Flag set: ${name}"
}

clear_flag() {
    local name="$1"
    rm -f "/tmp/.${name}_active"
    echo "[-] Flag cleared: ${name}"
}

INSTALL_COMPLETION=false
ACTION=""
CAPTURE=false
OUTPUT_DIR="."
QUEUE_OP=false

QUEUE_FILE="${XDG_RUNTIME_DIR:-/tmp}/.memsnap_queue"
SELECTED=()
[ -f "$QUEUE_FILE" ] && mapfile -t SELECTED < "$QUEUE_FILE"

usage() {
    echo "Usage: $0 [options]"
    echo "  -I          Install bash completion"
    echo "  -A <attack> Add attack to queue (repeatable; deduped)"
    echo "  -D <attack> Remove attack from queue"
    echo "  -C          Clear the entire queue"
    echo "  -l          List attacks in queue"
    echo "  -r          Run queued attacks (install)"
    echo "  -R [none]   Reverse queued attacks; cleans ALL if queue is empty"
    echo "  -s          Show active attacks"
    echo "  -a <dir>    Capture memory (standalone or after -r/-R)"
    exit 1
}

_save_queue() {
    printf '%s\n' "${SELECTED[@]}" > "$QUEUE_FILE"
}

_clear_queue() {
    SELECTED=()
    rm -f "$QUEUE_FILE"
}

is_valid_attack() {
    local name="$1"
    [ -x "$ATTACKS_DIR/$name" ]
}

while getopts "IA:D:ClrRa:s" opt; do
    case $opt in
        I) INSTALL_COMPLETION=true ;;

        A)
            if ! is_valid_attack "$OPTARG"; then
                echo "[!] Invalid attack: $OPTARG – skipping." >&2
                QUEUE_OP=true
                continue
            fi

            already=false
            for a in "${SELECTED[@]}"; do
                [ "$a" = "$OPTARG" ] && already=true && break
            done
            if $already; then
                echo "[!] '$OPTARG' already in queue" >&2
            else
                SELECTED+=("$OPTARG")
                _save_queue
            fi
            QUEUE_OP=true
            ;;

        D)  new=()
            for a in "${SELECTED[@]}"; do
                [ "$a" != "$OPTARG" ] && new+=("$a")
            done
            SELECTED=("${new[@]}")
            _save_queue
            QUEUE_OP=true
            ;;

        C)
            _clear_queue
            echo "[+] Queue cleared."
            exit 0
            ;;

        l) echo "${SELECTED[*]:-none}"; exit 0 ;;
        r) ACTION="install" ;;
        R) ACTION="clean" ;;

        a)  CAPTURE=true
            OUTPUT_DIR="$OPTARG"
            ;;

        s) ACTION="status" ;;

        *) usage ;;
    esac
done
shift $((OPTIND-1))

if $INSTALL_COMPLETION; then
    COMPLETION_FILE="/tmp/memsnap-completion.bash"
    _attack_list=""
    for f in "$ATTACKS_DIR"/*; do
        [ -x "$f" ] && _attack_list+="$(basename "$f") "
    done
    _attack_list="${_attack_list% }"

    cat > "$COMPLETION_FILE" << EOF
#!/usr/bin/env bash
_attack_list="$_attack_list"

_memsnap_infect_completion() {
    local cur prev words cword
    if declare -f _init_completion &>/dev/null; then
        _init_completion || return
    else
        cur="\${COMP_WORDS[COMP_CWORD]}"
        prev="\${COMP_WORDS[COMP_CWORD-1]}"
        words=(\${COMP_WORDS[@]})
        cword=\$COMP_CWORD
    fi

    if [ "\$cword" -eq 1 ]; then
        COMPREPLY=( \$(compgen -W "infect" -- "\$cur") )
        return
    fi

    [ "\${words[1]}" = "infect" ] || return

    case "\$prev" in
        -A|-D)
            COMPREPLY=( \$(compgen -W "\$_attack_list" -- "\$cur") )
            ;;
        *)
            COMPREPLY=( \$(compgen -W "-l -r -R -A -D -C -a -s -I" -- "\$cur") )
            ;;
    esac
}

complete -F _memsnap_infect_completion memsnap ./memsnap
EOF
    echo "[+] Completion script written to $COMPLETION_FILE"
    echo "    Source it now :  source $COMPLETION_FILE"
    echo "    Make permanent:  echo 'source $COMPLETION_FILE' >> ~/.bashrc"
    exit 0
fi

if [ "$ACTION" = "status" ]; then
    active=()
    for script in "$ATTACKS_DIR"/*; do
        name=$(basename "$script")
        [ -f "/tmp/.${name}_active" ] && active+=("$name")
    done
    [ ${#active[@]} -eq 0 ] && echo "[+] Machine is clean." || echo "[!] Active: ${active[*]}"
    exit 0
fi

if [ -z "$ACTION" ]; then
    $CAPTURE && { : ; } || { $QUEUE_OP && exit 0 || usage; }
fi

if [ -n "$ACTION" ]; then

    if [ "$ACTION" = "clean" ] && [ ${#SELECTED[@]} -eq 0 ]; then
        echo "[*] Queue empty – loading all known attacks for cleanup."
        for script in "$ATTACKS_DIR"/*; do
            [ -x "$script" ] && SELECTED+=("$(basename "$script")")
        done
    fi

    [ ${#SELECTED[@]} -eq 0 ] && { echo "[!] No attacks selected. Use -A." >&2; exit 1; }

    for attack in "${SELECTED[@]}"; do
        script="$ATTACKS_DIR/$attack"
        [ -x "$script" ] || { echo "[!] Unknown attack: $attack" >&2; exit 1; }
        source "$script"
        if [ "$ACTION" = "install" ]; then
            install_$attack
        else
            clean_$attack
        fi
    done

    echo "[+] $ACTION complete."
    _clear_queue
fi

if $CAPTURE; then
    AVML_DIR="$HOME/.local/bin"
    AVML_BIN="$AVML_DIR/avml"
    [ -x "$AVML_BIN" ] || {
        mkdir -p "$AVML_DIR"
        wget -q "https://github.com/microsoft/avml/releases/download/v0.14.0/avml" -O "$AVML_BIN"
        chmod +x "$AVML_BIN"
    }
    ts=$(date +%Y%m%d_%H%M%S)
    comps=()
    for script in "$ATTACKS_DIR"/*; do
        name=$(basename "$script")
        [ -f "/tmp/.${name}_active" ] && comps+=("$name")
    done
    [ ${#comps[@]} -eq 0 ] && comps=("clean")

    old_IFS="$IFS"
    IFS=_
    filename="memdump_${ts}_${comps[*]}.raw"
    IFS="$old_IFS"

    mkdir -p "$OUTPUT_DIR"
    echo "[*] Capturing to $OUTPUT_DIR/$filename ..."
    sudo "$AVML_BIN" --compress "$OUTPUT_DIR/$filename"
    echo "[+] Dump saved."
fi
