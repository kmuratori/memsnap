#!/usr/bin/env python3
"""detect — Two-stage malware detection from a Linux memory dump.

Stage 1 (binary_clf.joblib)  -- is this machine infected at all?
Stage 2 (family_clf.joblib)  -- which malware families are present?
                            (only runs if stage 1 says infected)

Plugin results are cached in SQLite via db.py so that re-running detection
against the same dump skips the expensive Volatility execution entirely.

Usage:
    detect <dump>
    detect <dump> -b binary_clf.joblib -m family_clf.joblib
    detect <dump> --no-cache
    detect <dump> --json
"""

import argparse
import json as _json
import sys
import time
from pathlib import Path

import pandas as pd

SCRIPT_DIR = Path(__file__).resolve().parent
LIB_DIR    = SCRIPT_DIR / ".." / "lib"
sys.path.insert(0, str(LIB_DIR))

ASSETS_DIR  = SCRIPT_DIR / ".." / "assets"
SYMBOLS_DIR = ASSETS_DIR / "symbols"
DEFAULT_BINARY_MODEL = ASSETS_DIR / "ai-model" / "binary_clf.joblib"
DEFAULT_FAMILY_MODEL = ASSETS_DIR / "ai-model" / "family_clf.joblib"

import db as _db
from memsnap_lib import (
    PLUGINS,
    SENTINEL,
    align_features,
    compute_checksum,
    extract_features,
    impute_sentinels,
    load_model,
    print_family_table,
    print_feature_vector,
    run_all_plugins,
    stage1_binary,
    stage2_families,
)


# -- Main ---------------------------------------------------------------------

def main() -> None:
    ap = argparse.ArgumentParser(
        description="Two-stage malware detection from a Linux memory dump"
    )
    ap.add_argument("dump",
                    help="Path to memory dump")
    ap.add_argument("-b", "--binary-model", default=str(DEFAULT_BINARY_MODEL),
                    dest="binary_model",
                    help="Path to binary_clf.joblib  (default: assets/ai-model/binary_clf.joblib)")
    ap.add_argument("-m", "--model", default=str(DEFAULT_FAMILY_MODEL),
                    help="Path to family_clf.joblib  (default: assets/ai-model/family_clf.joblib)")
    ap.add_argument("-t", "--threshold", type=float, default=0.5,
                    help="Probability threshold for both stages (default: 0.5)")
    ap.add_argument("-s", "--symbols", default=str(SYMBOLS_DIR),
                    help="Volatility symbols directory (default: assets/symbols)")
    ap.add_argument("-pw", "--plugin-workers", type=int, default=2,
                    dest="plugin_workers",
                    help="Parallel Volatility threads (default: 2)")
    ap.add_argument("--timeout", type=int, default=900,
                    help="Per-plugin timeout in seconds (default: 900)")
    ap.add_argument("--no-cache", action="store_true",
                    help="Ignore DB cache -- always re-run Volatility")
    ap.add_argument("--json", action="store_true",
                    help="Emit machine-readable JSON instead of human output")
    ap.add_argument("--db", type=Path, default=_db.DEFAULT_DB_PATH,
                    help=f"SQLite database path (default: {_db.DEFAULT_DB_PATH})")
    args = ap.parse_args()

    dump_path = Path(args.dump)
    if not dump_path.exists():
        print(f"[-] File not found: {args.dump}")
        sys.exit(1)

    # -- Open DB --------------------------------------------------------------
    con = _db.get_connection(args.db)

    # -- Load models ----------------------------------------------------------
    binary_model, binary_features, _, _           = load_model(args.binary_model, "Binary")
    family_model, family_features, label_names, _ = load_model(args.model,        "Family")

    # -- Checksum + dump record -----------------------------------------------
    if not args.json:
        print("[*] Computing checksum...", file=sys.stderr)

    sha256  = compute_checksum(dump_path)
    dump_id = _db.upsert_dump(
        con, sha256, dump_path.stat().st_size, str(dump_path)
    )

    # -- Cache lookup ---------------------------------------------------------
    extraction_id = None
    cache_hit     = False
    feats         = None

    if not args.no_cache:
        extraction_id = _db.get_cached_extraction(con, dump_id)
        if extraction_id is not None:
            feats = _db.load_features(con, extraction_id)
            if feats:
                cache_hit = True

    if not args.json:
        hit_str = "HIT" if cache_hit else "MISS"
        print(f"[+] sha256: {sha256[:16]}...  (cache {hit_str})", file=sys.stderr)

    # -- Run Volatility if needed ---------------------------------------------
    if not cache_hit:
        if not args.json:
            print(
                f"[*] Running Volatility plugins ({len(PLUGINS)})...",
                file=sys.stderr,
            )

        t0 = time.monotonic()
        plugin_results = run_all_plugins(
            dump_path,
            args.symbols,
            plugin_workers=args.plugin_workers,
            verbose=not args.json,
            timeout=args.timeout,
        )
        elapsed = time.monotonic() - t0

        feats = extract_features(plugin_results)

        extraction_id = _db.insert_extraction(
            con, dump_id,
            elapsed=elapsed,
            vol_version=None,
            success=True,
        )
        _db.insert_plugin_results(con, extraction_id, plugin_results)
        _db.insert_features(con, extraction_id, feats)

    # -- Build feature matrix -------------------------------------------------
    X_raw = pd.DataFrame([feats])

    n_sentinel = sum(1 for v in feats.values() if v == SENTINEL)
    n_total    = len(feats)

    if not args.json:
        print_feature_vector(
            impute_sentinels(
                align_features(
                    X_raw.copy(),
                    binary_features or list(X_raw.columns),
                )
            )
        )

    if n_sentinel > n_total // 2:
        msg = (
            f"[!] WARNING: {n_sentinel}/{n_total} features are sentinel (-1) --\n"
            f"    most Volatility plugins returned no data.\n"
            f"    Results below are based on imputed defaults and are NOT reliable.\n"
            f"    Check that 'vol' is on PATH, symbol path is correct, "
            f"and the dump is valid."
        )
        print(msg, file=sys.stderr)
        if not args.json:
            print(msg)

    # -- Stage 1 — binary triage ----------------------------------------------
    t_scan = time.monotonic()

    is_infected, binary_conf = stage1_binary(
        binary_model, binary_features, X_raw, args.threshold
    )

    if args.json:
        output = {
            "dump":          str(dump_path),
            "sha256":        sha256,
            "cache_hit":     cache_hit,
            "infected":      is_infected,
            "infected_conf": round(binary_conf, 4) if binary_conf is not None else None,
            "families":      None,
        }
    else:
        conf_str = f"{binary_conf:.1%}" if binary_conf is not None else "n/a"
        status   = "INFECTED" if is_infected else "CLEAN"
        marker   = "[!]" if is_infected else "[+]"
        print(f"\n{'=' * 56}")
        print("STAGE 1 -- BINARY TRIAGE")
        print(f"{'=' * 56}")
        print(f"{marker} Status: {status}  (confidence: {conf_str})")

    # -- Stage 2 — family identification (only if infected) -------------------
    family_results = None

    if is_infected:
        family_results = stage2_families(
            family_model, family_features, label_names, X_raw, args.threshold
        )
        if args.json:
            output["families"] = family_results
        else:
            print("\nSTAGE 2 -- FAMILY IDENTIFICATION")
            print_family_table(family_results)
    else:
        if not args.json:
            print("\n[+] Stage 2 skipped -- machine is clean.\n")

    # -- Persist scan record --------------------------------------------------
    elapsed_scan = time.monotonic() - t_scan

    scan_id = _db.insert_scan(
        con,
        dump_id=dump_id,
        extraction_id=extraction_id,
        pipeline="binary+family" if is_infected else "binary",
        binary_model=args.binary_model,
        family_model=args.model,
        cache_hit=cache_hit,
        elapsed_sec=elapsed_scan,
        stage1_infected=is_infected,
        stage1_conf=binary_conf,
    )

    if family_results:
        _db.insert_verdicts(con, scan_id, family_results)

    con.close()

    # -- Emit JSON ------------------------------------------------------------
    if args.json:
        print(_json.dumps(output, indent=2))


if __name__ == "__main__":
    main()
